# API keys — copy to .env and fill in
# Never commit .env to git

# ── LLM providers ─────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# ── Optional: LangSmith tracing ───────────────────────────────────────────────

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=lessonforge

# ── Provider override (set to "mock" to run without any API key) ──────────────

LESSONFORGE_PROVIDER=openai
